FROM node:22.17.0-bookworm-slim
RUN npm install --global pnpm@10.31.0
WORKDIR /opt/penpot
RUN npm pack @penpot/mcp@2.15.4 --pack-destination /tmp && tar -xzf /tmp/penpot-mcp-2.15.4.tgz --strip-components=1 && rm /tmp/penpot-mcp-2.15.4.tgz
RUN pnpm install --no-frozen-lockfile && pnpm run build
ENV PENPOT_MCP_SERVER_HOST=0.0.0.0 PENPOT_MCP_PLUGIN_SERVER_HOST=0.0.0.0 PENPOT_MCP_REMOTE_MODE=true WS_URI=http://localhost:4402
RUN chown -R node:node /opt/penpot
USER node
EXPOSE 4400 4401 4402
CMD ["pnpm", "run", "start"]
